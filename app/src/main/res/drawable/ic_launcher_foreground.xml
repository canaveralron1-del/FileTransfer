<?xml version="1.0" encoding="utf-8"?>
<!-- Radar rings + phone with up-arrow, converted from 1024x1024 SVG.
     Outer ring extends past the 66dp safe zone by design (decorative, 15% opacity). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">

    <!-- Outer radar ring -->
    <path
        android:pathData="M512,172 A340,340 0 1,1 512,852 A340,340 0 1,1 512,172 Z"
        android:strokeColor="#10B981"
        android:strokeWidth="24"
        android:strokeAlpha="0.15" />

    <!-- Inner radar ring -->
    <path
        android:pathData="M512,272 A240,240 0 1,1 512,752 A240,240 0 1,1 512,272 Z"
        android:strokeColor="#10B981"
        android:strokeWidth="32"
        android:strokeAlpha="0.4" />

    <!-- Phone body -->
    <path
        android:pathData="M410,262 L614,262 A48,48 0 0 1 662,310 L662,714 A48,48 0 0 1 614,762 L410,762 A48,48 0 0 1 362,714 L362,310 A48,48 0 0 1 410,262 Z"
        android:fillColor="#1E293B"
        android:strokeColor="#F8FAFC"
        android:strokeWidth="32" />

    <!-- Phone speaker line -->
    <path
        android:pathData="M460,320 L564,320"
        android:strokeColor="#F8FAFC"
        android:strokeWidth="24"
        android:strokeLineCap="round" />

    <!-- Up arrow -->
    <path
        android:pathData="M512,430 L512,630 M512,430 L430,512 M512,430 L594,512"
        android:strokeColor="#10B981"
        android:strokeWidth="48"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
